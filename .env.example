# 复制本文件为 .env 后按需修改；.env 不会被提交到仓库。
# 不配置也能直接运行，所有项都有默认值。

# 部署子路径：放在网站根目录用 /，放在 GitHub Pages 等子目录用 /你的仓库名/
VITE_BASE_PATH=/

# 「设置 → 数据」里显示的版本文字，可改成你自己的版本号
VITE_APP_VERSION=1.2.2
VITE_BUILD_CODE=1

# 自建安卓安装包时，指向你自己的版本清单地址。
# 留空 = 关闭应用内更新检查，不会连接任何外部地址。
VITE_VERSION_URL=

# 设为 1 可把网页构建成单个 HTML 文件，方便离线保存或转发
# SINGLE_FILE=1
